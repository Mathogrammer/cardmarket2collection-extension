{
    "name": "cardmarket2archidekt",
    "version": "0.2.0",
    "displayName": "Cardmarket to Archidekt Import Extension",
    "author": "Mathogrammer",
    "description": "A web extension to import bought Cardmarket cards into your Archidekt Collection.",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build-v2": "cross-env MANIFEST_VERSION=2 vite build",
        "build-v3": "cross-env MANIFEST_VERSION=3 vite build",
        "watch": "vite build --watch --mode development --minify false",
        "dev": "vite",
        "serve:firefox": "dotenv -- web-ext run",
        "serve:chrome": "dotenv -- web-ext run -t chromium",
        "build-serve-firefox": "yarpm run build-v2 && yarpm run serve:firefox",
        "build-serve-chrome": "yarpm run build-v3 && yarpm run serve:chrome",
        "package": "zip -r cardmarket2archidekt.xpi ./dist"
    },
    "license": "MIT",
    "devDependencies": {
        "@samrum/vite-plugin-web-extension": "5.1.1",
        "@types/chrome": "0.2.5",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@types/webextension-polyfill": "0.12.5",
        "@vitejs/plugin-react": "6.0.5",
        "cross-env": "10.1.0",
        "dotenv-cli": "11.0.0",
        "typescript": "7.0.2",
        "vite": "8.2.1",
        "web-ext": "10.6.0",
        "yarpm": "1.2.0"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "axios": "1.19.0",
        "fuzzysort": "^3.1.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "scryfall-sdk": "5.0.3",
        "tailwindcss": "^4.3.3",
        "webextension-polyfill": "0.12.0"
    }
}
